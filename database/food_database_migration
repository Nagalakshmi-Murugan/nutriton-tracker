-- ============================================================
-- Rebuild food_database only (safe to re-run anytime)
-- Does NOT touch the "foods" table or any logged history.
-- ============================================================

USE nutrition_tracker;

DROP TABLE IF EXISTS food_database;

CREATE TABLE food_database (
    id                  INT AUTO_INCREMENT PRIMARY KEY,
    name                VARCHAR(100) NOT NULL UNIQUE,
    calories_per_100g   DECIMAL(6,1) NOT NULL,
    protein_per_100g    DECIMAL(6,1) NOT NULL,
    carbs_per_100g      DECIMAL(6,1) NOT NULL,
    fat_per_100g        DECIMAL(6,1) NOT NULL
);

